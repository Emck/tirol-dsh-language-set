{
    "name": "@tirol/dsh-language-set",
    "version": "0.1.1",
    "description": "DeepSeek Harness plugin: Set AI Language via system prompt injection",
    "license": "MIT",
    "author": "Emck",
    "keywords": [
        "deepseek-harness",
        "dsh",
        "plugin",
        "language-set",
        "system-prompt",
        "ai-language"
    ],
    "type": "module",
    "main": "./lib/index.mjs",
    "types": "./lib/index.d.mts",
    "exports": {
        ".": {
            "types": "./lib/index.d.mts",
            "default": "./lib/index.mjs"
        },
        "./package.json": "./package.json",
        "./cordis.patch.yml": "./cordis.patch.yml"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "README.zh.md",
        "LICENSE"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "^22.19.0 || >=24.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run tests",
        "check": "pnpm run typecheck && pnpm run test && pnpm run build",
        "prepack": "pnpm run check"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "^4.0.2",
        "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
        "@deepseek-ai/schemastery": "^3.18.2",
        "@types/node": "^22.20.2",
        "tsdown": "0.22.14",
        "typescript": "6.0.3",
        "vitest": "^4.1.10"
    }
}